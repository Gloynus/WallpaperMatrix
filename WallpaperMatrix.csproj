<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>WallpaperMatrix</AssemblyName>
    <AssemblyTitle>Wallpaper Matrix</AssemblyTitle>
    <RootNamespace>WallpaperMatrix</RootNamespace>
    <Product>Wallpaper Matrix</Product>
    <Description>Animated Matrix-style desktop wallpaper for Windows 10 and 11.</Description>
    <Company>Gloynus Aleos</Company>
    <Authors>Gloynus Aleos</Authors>
    <Copyright>Copyright © 2026 Gloynus Aleos</Copyright>
    <RepositoryUrl>https://github.com/Gloynus/WallpaperMatrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Version>3.7.3</Version>
    <AssemblyVersion>3.7.3.0</AssemblyVersion>
    <FileVersion>3.7.3.0</FileVersion>
    <InformationalVersion>3.7.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WallpaperMatrix.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <Resource Include="Assets\WallpaperMatrix.ico" />
  </ItemGroup>

</Project>
