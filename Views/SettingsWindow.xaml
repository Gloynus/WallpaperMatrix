                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="CurveHorizontalShiftSlider"
                                                        Minimum="-1" Maximum="1" Value="0"
