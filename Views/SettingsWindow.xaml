                                                    <TextBlock Text="%/с" Margin="3,3,0,0"
                                                               FontFamily="Consolas" Foreground="#83FFAA"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom" Margin="0,0,7,18">
                                                    <TextBlock Text="ДО" FontFamily="Consolas"
                                                               FontWeight="Bold" Foreground="#83FFAA"
                                                               VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource HelpButton}"
                                                            ToolTip="Задаёт максимальную скорость в процентах высоты экрана за секунду."/>
                                                    <TextBox x:Name="CalibrationSpeedMaxInput" Tag="SpeedMax"
                                                             Margin="5,0,0,0"
                                                             Style="{StaticResource NumericInput}"
                                                             ToolTip="Ползунок и колесо: 1–100%/с. Ручной ввод: до 1000%/с."/>
                                                    <TextBlock Text="%/с" Margin="3,3,0,0"
                                                               FontFamily="Consolas" Foreground="#83FFAA"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid x:Name="FilterAxisPanel" Visibility="Collapsed">
