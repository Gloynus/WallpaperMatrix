                                        <Border Height="8" VerticalAlignment="Center"
                                                CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5"
                                                                     EndPoint="1,0.5">
                                                    <GradientStop Color="#000000"
                                                                  Offset="0"/>
                                                    <GradientStop x:Name="SignalBrightnessGradientStop"
                                                                  Color="#00FF6A"
                                                                  Offset="0.5"/>
                                                    <GradientStop Color="#FFFFFF"
                                                                  Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider x:Name="SignalBrightnessSlider"
                                                Style="{StaticResource TerminalColorSlider}"
                                                Minimum="0" Maximum="2"
                                                TickFrequency="0.01"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBox x:Name="SignalBrightnessInput"
                                                 Tag="SignalBrightness"
                                                 Width="78"
                                                 Style="{StaticResource NumericInput}"/>
                                        <TextBlock Text="%" Margin="4,3,0,0"
                                                   FontFamily="Consolas"
                                                   Foreground="#83FFAA"/>
                                    </StackPanel>
                                </Grid>

