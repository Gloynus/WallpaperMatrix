                                                Style="{StaticResource ResetParameterButton}"
                                                Tag="FontFamily"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <TextBox x:Name="FontSizeInput" Tag="FontSize"
                                                 Width="82" Style="{StaticResource NumericInput}"/>
                                        <TextBlock Text="px" Margin="4,3,0,0"
                                                   FontFamily="Consolas" Foreground="#83FFAA"/>
                                    </StackPanel>
