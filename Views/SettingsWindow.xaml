                                                        Tag="CurveHorizontalShift"
                                                        Width="18" Height="18" Margin="3,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CurveEditingHint"
                                       Text="Крайние точки закреплены. ЛКМ создаёт или перемещает внутреннюю точку; ПКМ либо Delete удаляет её."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
