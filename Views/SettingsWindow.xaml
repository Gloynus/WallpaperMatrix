                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Row="0">
                                                <Slider x:Name="CurveVerticalShiftSlider"
                                                        Orientation="Vertical"
                                                        Minimum="-1" Maximum="1" Value="0"
                                                        TickFrequency="0.01" Margin="0,4,0,24"
