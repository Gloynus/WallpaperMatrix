                                                               FontFamily="Consolas" Foreground="#83FFAA"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom" Margin="0,0,7,18">
                                                    <TextBlock Text="ОТ" FontFamily="Consolas"
                                                               FontWeight="Bold" Foreground="#83FFAA"
                                                               VerticalAlignment="Center"/>
