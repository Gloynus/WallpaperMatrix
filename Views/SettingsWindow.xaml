                                                ToolTip="Выбирает системный шрифт потока с подстановкой отсутствующих знаков."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="РАЗМЕР" FontFamily="Consolas"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#83FFAA"/>
                                        <Button Style="{StaticResource HelpButton}"
                                                ToolTip="Размер знака: 1 px выводится как точка, 48 px — как крупный символ."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="ВЫСОТА" FontFamily="Consolas"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#83FFAA"/>
                                        <Button Style="{StaticResource HelpButton}"
                                                ToolTip="Меняет вертикальные пропорции. 0 — исходная высота; −99 — однопиксельная полоса; 200 — двойная высота."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <TextBlock Text="ЖИРНОСТЬ" FontFamily="Consolas"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#83FFAA"/>
