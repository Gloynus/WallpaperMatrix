                                                ToolTip="Выбирает оттенок фона терминала. При яркости 0% фон остаётся чисто чёрным."/>
                                        <Border x:Name="BackgroundHueSwatch" Width="18" Height="18"
                                                Margin="7,0,0,0" CornerRadius="3"
                                                BorderBrush="#83FFAA" BorderThickness="1"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Height="24" Margin="10,0,8,0">
                                        <Border Height="8" VerticalAlignment="Center"
                                                CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#FF0000" Offset="0"/>
                                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                                    <GradientStop Color="#FF0000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider x:Name="BackgroundHueSlider"
                                                Style="{StaticResource TerminalColorSlider}"
                                                Minimum="0" Maximum="359" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBox x:Name="BackgroundHueInput" Tag="BackgroundHue"
                                                 Width="78" Style="{StaticResource NumericInput}"/>
                                        <TextBlock Text="°" Margin="4,3,0,0"
                                                   FontFamily="Consolas" Foreground="#83FFAA"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="6" Margin="8,2,8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="ФОН ЯРКОСТЬ" FontFamily="Consolas"
                                                   FontWeight="Bold" Foreground="#83FFAA"/>
                                        <Button Style="{StaticResource HelpButton}"
                                                ToolTip="Яркость фона: 0% — чёрный, 100% — чистый выбранный спектр, 200% — белый."/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" Height="24" Margin="10,0,8,0">
                                        <Border Height="8" VerticalAlignment="Center"
                                                CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#000000" Offset="0"/>
                                                    <GradientStop x:Name="BackgroundBrightnessGradientStop"
                                                                  Color="#00FF6A" Offset="0.5"/>
                                                    <GradientStop Color="#FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Slider x:Name="BackgroundBrightnessSlider"
                                                Style="{StaticResource TerminalColorSlider}"
                                                Minimum="0" Maximum="2" TickFrequency="0.01"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBox x:Name="BackgroundBrightnessInput"
                                                 Tag="BackgroundBrightness"
                                                 Width="78" Style="{StaticResource NumericInput}"/>
                                        <TextBlock Text="%" Margin="4,3,0,0"
                                                   FontFamily="Consolas" Foreground="#83FFAA"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ClockEnabledCheck" Content="ЧАСЫ В ПОТОКЕ"
                                              FontFamily="Consolas" FontWeight="Bold"
                                              Foreground="#00E667"/>
                                    <Button Style="{StaticResource HelpButton}" VerticalAlignment="Center"
                                            ToolTip="Показывает время пятью ячейками текущего потока."/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ResetParameterButton}"
                                        Tag="ClockBlock" VerticalAlignment="Center"
                                        ToolTip="Сбросить весь блок часов"/>
                            </Grid>
                            <StackPanel x:Name="ClockContentPanel">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Положение"/>
                                        <Button Style="{StaticResource HelpButton}" ToolTip="Определяет край экрана, у которого размещаются часы."/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ClockPositionCombo">
                                            <ComboBoxItem Content="Сверху" Tag="Top"/>
                                            <ComboBoxItem Content="Сверху справа" Tag="TopRight"/>
                                            <ComboBoxItem Content="Справа" Tag="Right"/>
                                            <ComboBoxItem Content="Снизу справа" Tag="BottomRight"/>
                                            <ComboBoxItem Content="Снизу" Tag="Bottom"/>
                                            <ComboBoxItem Content="Снизу слева" Tag="BottomLeft"/>
                                            <ComboBoxItem Content="Слева" Tag="Left"/>
                                            <ComboBoxItem Content="Сверху слева" Tag="TopLeft"/>
                                        </ComboBox>
                                        <Button Grid.Column="1" Style="{StaticResource ResetParameterButton}"
                                                Tag="ClockPosition"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Отступы в символах" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="По X" Foreground="{StaticResource MutedBrush}"/>
                                        <Button Style="{StaticResource HelpButton}" ToolTip="Задаёт горизонтальный отступ часов в ячейках."/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" x:Name="ClockHorizontalMarginInput" Tag="ClockHorizontalMargin" Style="{StaticResource NumericInput}"/>
                                            </Grid>
                                            <Slider x:Name="ClockHorizontalMarginSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnySlider_ValueChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="По Y" Foreground="{StaticResource MutedBrush}"/>
                                        <Button Style="{StaticResource HelpButton}" ToolTip="Задаёт вертикальный отступ часов в ячейках."/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" x:Name="ClockVerticalMarginInput" Tag="ClockVerticalMargin" Style="{StaticResource NumericInput}"/>
                                            </Grid>
                                            <Slider x:Name="ClockVerticalMarginSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AnySlider_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Светимость часов"/>
                                            <Button Style="{StaticResource HelpButton}" ToolTip="Задаёт минимальную яркость часов после затухания."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="ClockBrightnessInput" Tag="ClockBrightness" Style="{StaticResource NumericInput}"/>
                                            <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="ClockBrightnessSlider" Minimum="0.5" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Начертание часов"/>
                                            <Button Style="{StaticResource HelpButton}" ToolTip="Определяет толщину пяти символов времени."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="ClockWeightInput" Tag="ClockWeight" Style="{StaticResource NumericInput}"/>
                                            <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="ClockWeightSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ImageModeCheck" Content="БАЗА ДАННЫХ"
                                              FontFamily="Consolas" FontWeight="Bold"
                                              Foreground="#00E667"/>
                                    <Button Style="{StaticResource HelpButton}" VerticalAlignment="Center"
                                            ToolTip="Включает проявление образов символами текущего потока."/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ResetParameterButton}"
                                        Tag="DatabaseBlock" VerticalAlignment="Center"
                                        ToolTip="Сбросить всю базу данных"/>
                            </Grid>
                            <StackPanel x:Name="DatabaseContentPanel">
                            <Border Style="{StaticResource SubsectionBorder}">
                            <StackPanel>
                            <TextBlock Text="ИСТОЧНИКИ" FontFamily="Consolas"
                                       FontWeight="Bold" Foreground="#00E667"
                                       Margin="0,0,0,7"/>
                            <TextBlock Text="Фотографии не рисуются поверх обоев: свет и контуры собираются только из зелёных символов."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Плейлист образов"/>
                                <Button Style="{StaticResource HelpButton}"
                                        ToolTip="Определяет набор и порядок образов для показа."/>
                            </StackPanel>
                            <Border Background="#04110A" BorderBrush="#164B2C" BorderThickness="1"
                                    CornerRadius="4" Padding="10">
                                <StackPanel x:Name="PlaylistEditorPanel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Активный плейлист" Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="PlaylistCombo"
                                                          SelectionChanged="PlaylistCombo_SelectionChanged"/>
                                                <Button Grid.Column="1" Content="＋"
                                                        Style="{StaticResource QuickIconButton}"
                                                        Width="28" Height="29" Margin="5,0,0,0"
                                                        Click="NewPlaylistButton_Click"
                                                        ToolTip="Создать новый плейлист"/>
                                                <Button Grid.Column="2" Content="−"
                                                        Style="{StaticResource QuickIconButton}"
                                                        Width="28" Height="29"
                                                        Click="DeletePlaylistButton_Click"
                                                        ToolTip="Удалить активный плейлист"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="PlaylistNameTextBox"
                                                         Background="#031009" Foreground="#83FFAA"
                                                         BorderBrush="#164B2C" Padding="8,6"
                                                         FontFamily="Consolas"
                                                         TextChanged="PlaylistNameTextBox_TextChanged"/>
                                                <Button Grid.Column="1" Content="&#xE74E;"
                                                        Style="{StaticResource QuickIconButton}"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Width="30" Height="29" Margin="5,0,0,0"
                                                        Click="SavePlaylistButton_Click"
                                                        ToolTip="Сохранить название и состав плейлиста"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="или перетащите файлы и папки в список"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="&#xE710; &#xE8A5;" Style="{StaticResource QuickIconButton}"
                                                    FontFamily="Segoe MDL2 Assets" Width="38" Height="28"
                                                    Click="AddPlaylistFilesButton_Click"
                                                    ToolTip="Добавить файлы изображений"/>
                                            <Button Content="&#xE710; &#xE8B7;" Style="{StaticResource QuickIconButton}"
                                                    FontFamily="Segoe MDL2 Assets" Width="38" Height="28"
                                                    Click="AddPlaylistFolderButton_Click"
                                                    ToolTip="Добавить изображения из папки"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid x:Name="PlaylistList" Height="225"
                                              Width="{Binding ActualWidth, ElementName=PlaylistEditorPanel}"
                                              AutoGenerateColumns="False"
                                              CanUserResizeColumns="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                              AllowDrop="True"
                                              PreviewDragOver="PlaylistList_PreviewDragOver"
                                              Drop="PlaylistList_Drop"
                                              MouseDoubleClick="PlaylistList_MouseDoubleClick"
                                              PreviewMouseRightButtonDown="PlaylistList_PreviewMouseRightButtonDown"
                                              SizeChanged="PlaylistList_SizeChanged">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu Background="#020806" BorderBrush="#238A4B"
                                                         BorderThickness="1" Padding="3">
                                                <MenuItem Header="＋  Новый плейлист" Style="{StaticResource MatrixMenuItem}"
                                                          Click="NewPlaylistButton_Click"/>
                                                <MenuItem Header="▣  Сохранить плейлист" Style="{StaticResource MatrixMenuItem}"
                                                          Click="SavePlaylistButton_Click"/>
                                                <MenuItem Header="−  Удалить плейлист" Style="{StaticResource MatrixMenuItem}"
                                                          Click="DeletePlaylistButton_Click"/>
                                                <Separator Style="{StaticResource MatrixMenuSeparator}"/>
                                                <MenuItem Header="＋▤  Добавить файлы…" Style="{StaticResource MatrixMenuItem}"
                                                          Click="AddPlaylistFilesButton_Click"/>
                                                <MenuItem Header="＋▰  Добавить папку…" Style="{StaticResource MatrixMenuItem}"
                                                          Click="AddPlaylistFolderButton_Click"/>
                                                <Separator Style="{StaticResource MatrixMenuSeparator}"/>
                                                <MenuItem Header="▦  Выделить всё" Style="{StaticResource MatrixMenuItem}"
                                                          Click="SelectAllPlaylistEntries_Click"/>
                                                <MenuItem Header="◩  Инвертировать выделение" Style="{StaticResource MatrixMenuItem}"
                                                          Click="InvertPlaylistSelection_Click"/>
                                                <MenuItem Header="□  Снять выделение" Style="{StaticResource MatrixMenuItem}"
                                                          Click="ClearPlaylistSelection_Click"/>
                                                <Separator Style="{StaticResource MatrixMenuSeparator}"/>
                                                <MenuItem Header="✓  Включить выделенные" Style="{StaticResource MatrixMenuItem}"
                                                          Click="EnableSelectedPlaylistEntries_Click"/>
                                                <MenuItem Header="○  Выключить выделенные" Style="{StaticResource MatrixMenuItem}"
                                                          Click="DisableSelectedPlaylistEntries_Click"/>
                                                <MenuItem Header="✕  Удалить выделенные" Style="{StaticResource MatrixMenuItem}"
                                                          Click="DeleteSelectedPlaylistEntries_Click"/>
                                                <Separator Style="{StaticResource MatrixMenuSeparator}"/>
                                                <MenuItem Header="А↕Я  Сменить сортировку имени" Style="{StaticResource MatrixMenuItem}"
                                                          Click="SortPlaylistEntries_Click"/>
                                                <MenuItem Header="◷  Сменить сортировку даты" Style="{StaticResource MatrixMenuItem}"
                                                          Click="SortPlaylistEntriesByDate_Click"/>
                                                <MenuItem Header="⤨  Перемешать" Style="{StaticResource MatrixMenuItem}"
                                                          Click="ShufflePlaylistEntries_Click"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn x:Name="PlaylistEnabledColumn"
                                                                    Header="ВКЛ." Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Click="PlaylistEntryEnabled_Click"
                                                                  ToolTip="Включает образ в текущий проход плейлиста"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="PlaylistNameColumn"
                                                                    Header="ИМЯ" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="PlaylistLocationColumn"
                                                                    Header="РАСПОЛОЖЕНИЕ" Width="3*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding Path}"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="PlaylistResolutionColumn"
                                                                    Header="РАЗРЕШЕНИЕ" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Resolution}" FontFamily="Consolas"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="Показывает разрешение файла"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn x:Name="PlaylistActionsColumn"
                                                                    Header="" Width="78">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,0,8,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Button Content="▶" Style="{StaticResource QuickIconButton}"
                                                                    Click="PlayPlaylistEntry_Click"
                                                                    ToolTip="Показать этот образ сейчас"/>
                                                            <Button Content="✕" Style="{StaticResource QuickIconButton}"
                                                                    Click="DeletePlaylistEntry_Click"
                                                                    ToolTip="Удалить образ из плейлиста"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="7"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Button Content="ВЫДЕЛИТЬ ВСЕ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="SelectAllPlaylistEntries_Click"/>
                                            <Button Content="ИНВЕРТИРОВАТЬ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="InvertPlaylistSelection_Click"/>
                                            <Button Content="СНЯТЬ ВЫДЕЛЕНИЕ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="ClearPlaylistSelection_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Button Content="ВКЛЮЧИТЬ ВЫДЕЛЕННЫЕ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="EnableSelectedPlaylistEntries_Click"/>
                                            <Button Content="ВЫКЛЮЧИТЬ ВЫДЕЛЕННЫЕ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="DisableSelectedPlaylistEntries_Click"/>
                                            <Button Content="УДАЛИТЬ ВЫДЕЛЕННЫЕ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="DeleteSelectedPlaylistEntries_Click"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <Button x:Name="NameSortButton" Content="А–Я"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="SortPlaylistEntries_Click"/>
                                            <Button x:Name="DateSortButton" Content="НОВЕЕ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="SortPlaylistEntriesByDate_Click"/>
                                            <Button Content="ПЕРЕМЕШАТЬ"
                                                    Style="{StaticResource PlaylistCommandButton}"
                                                    Click="ShufflePlaylistEntries_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Цикл образа"/>
                                            <Button Style="{StaticResource HelpButton}"
                                                    ToolTip="Задаёт время показа образа до перехода к следующему."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="DurationInput" Tag="Duration"
                                                     Style="{StaticResource NumericInput}"
                                                     ToolTip="Ползунок: 3–600 с. Ручной ввод: 0,1–600 с."/>
                                            <TextBlock Text="с" Margin="4,3,0,0"
                                                       FontFamily="Consolas" Foreground="#83FFAA"/>
                                        </StackPanel>
                                    </Grid>
                                    <Slider x:Name="DurationSlider" Minimum="3" Maximum="600"
                                            TickFrequency="1" ValueChanged="AnySlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubsectionBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="АНАЛИЗ" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="#00E667"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ResetParameterButton}"
                                        Tag="AnalysisBlock"
                                        ToolTip="Сбросить весь анализ данных"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Подготовка образа"/>
                                        <Button Style="{StaticResource HelpButton}"
                                                ToolTip="Выбирает готовый профиль анализа изображения."/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ImagePreparationModeCombo"
                                                  SelectionChanged="ImagePreparationModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="Без подготовки" Tag="None"/>
                                            <ComboBoxItem Content="Автоматическая проявка" Tag="Auto"/>
                                            <ComboBoxItem Content="Портрет" Tag="Portrait"/>
                                            <ComboBoxItem Content="Контурный сигнал" Tag="Contours"/>
                                            <ComboBoxItem Content="Силуэт" Tag="Silhouette"/>
                                            <ComboBoxItem Content="Ручная проявка" Tag="Custom"/>
                                        </ComboBox>
                                        <Button Grid.Column="1" Style="{StaticResource ResetParameterButton}"
                                                Tag="ImagePreparationMode"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="ImageStructurePanel" Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Структура сигнала"/>
                                        <Button Style="{StaticResource HelpButton}"
                                                ToolTip="Выбирает тональный, контурный или силуэтный способ разбора изображения."/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ImageStructureModeCombo">
                                            <ComboBoxItem Content="Тон" Tag="Tonal"/>
                                            <ComboBoxItem Content="Контуры" Tag="Contours"/>
                                            <ComboBoxItem Content="Силуэт" Tag="Silhouette"/>
                                        </ComboBox>
                                        <Button Grid.Column="1" Style="{StaticResource ResetParameterButton}"
                                                Tag="ImageStructureMode"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ImagePreparationDescription"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                            <Grid x:Name="ImagePreparationCustomPanel"
                                  Visibility="Collapsed" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Локальная проявка"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Выравнивает контраст отдельных участков изображения."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageLocalContrastInput" Tag="ImageLocalContrast" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageLocalContrastSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Резкость деталей"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Подчёркивает мелкие детали после уменьшения изображения."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageDetailStrengthInput" Tag="ImageDetailStrength" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageDetailStrengthSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Сила контуров"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Добавляет к тональной карте границы крупных форм."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageEdgeStrengthInput" Tag="ImageEdgeStrength" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageEdgeStrengthSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Проявление теней"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Регулирует количество информации, извлекаемой из тёмных участков."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageShadowBalanceInput" Tag="ImageShadowBalance" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageShadowBalanceSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Разделение палитры"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Разводит близкие тона по доступным ступеням символьной палитры."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImagePaletteAdaptationInput"
                                                         Tag="ImagePaletteAdaptation"
                                                         Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImagePaletteAdaptationSlider"
                                                Minimum="0" Maximum="1" TickFrequency="0.01"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Тональная равномерность"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Снижает долю предельно светлых и тёмных областей, сохраняя полутона."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageToneCalmnessInput"
                                                         Tag="ImageToneCalmness"
                                                         Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageToneCalmnessSlider"
                                                Minimum="0" Maximum="1" TickFrequency="0.01"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SubsectionBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ВЫВОД" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="#00E667"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ResetParameterButton}"
                                        Tag="OutputBlock"
                                        ToolTip="Сбросить весь вывод данных"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Точность символов"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Определяет вероятность подбора знака по тону точки изображения."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageGlyphMatchInput" Tag="ImageGlyphMatch" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageGlyphMatchSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Стабильность света"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Доля Цикла образа, в течение которой новый видимый символ сохраняет требуемую изображением яркость. После этого он угасает по своей Памяти."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageStabilityInput" Tag="ImageStability" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageStabilitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Устойчивость тени"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Скорость, с которой новый символ гасится до требуемой изображением яркости: 0% — без влияния; 50% — вдвое быстрее; 100% — сразу. Уже созданные символы не пересчитываются."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageResistanceInput" Tag="ImageResistance" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageResistanceSlider" Minimum="0" Maximum="1" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Яркость"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Определяет итоговую яркость символов проявленного образа."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageBrightnessInput" Tag="ImageBrightness" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageBrightnessSlider" Minimum="0" Maximum="1.5" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Контраст"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Расширяет или сжимает тональный диапазон проявленного образа."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ImageExpressivenessInput" Tag="ImageExpressiveness" Style="{StaticResource NumericInput}"/>
                                                <TextBlock Text="%" Margin="4,3,0,0" FontFamily="Consolas" Foreground="#83FFAA"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="ImageExpressivenessSlider" Minimum="0" Maximum="1.5" TickFrequency="0.01" ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Масштаб образа"/>
                                    <Button Style="{StaticResource HelpButton}"
                                            ToolTip="Определяет вписывание изображения целиком или заполнение экрана с обрезкой."/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ImageFitCombo">
                                        <ComboBoxItem Content="Вписать целиком" Tag="Uniform"/>
                                        <ComboBoxItem Content="Заполнить экран" Tag="Fill"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Style="{StaticResource ResetParameterButton}" Tag="ImageFit"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="AttackSystemEnabledCheck"
                                              Content="АТАКА СИСТЕМЫ"
                                              FontFamily="Consolas"
                                              FontWeight="Bold"
                                              Foreground="#00E667"/>
                                    <Button Style="{StaticResource HelpButton}"
                                            VerticalAlignment="Center"
                                            ToolTip="После заданного бездействия поток захватывает интерфейс системы. Любой ввод быстро возвращает рабочий стол."/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ResetParameterButton}"
                                        Tag="AttackBlock"
                                        VerticalAlignment="Center"
                                        ToolTip="Сбросить настройки атаки системы"/>
                            </Grid>
                            <StackPanel x:Name="AttackContentPanel"
                                        Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Бездействие"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Задаёт время без ввода, после которого начинается атака."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="AttackIdleMinutesInput"
                                                         Tag="AttackIdleMinutes"
                                                         Style="{StaticResource NumericInput}"
                                                         ToolTip="Ползунок: 1–120 мин. Ручной ввод: 1–1440 мин."/>
                                                <TextBlock Text="мин" Margin="4,3,0,0"
                                                           FontFamily="Consolas" Foreground="#83FFAA"/>
                                                <Button Style="{StaticResource ResetParameterButton}"
                                                        Tag="AttackIdleMinutes"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="AttackIdleMinutesSlider"
                                                Minimum="1" Maximum="120"
                                                TickFrequency="1"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Захват системы"/>
                                                <Button Style="{StaticResource HelpButton}"
                                                        ToolTip="Задаёт длительность превращения интерфейса в фон и символы потока."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="AttackTransitionSecondsInput"
                                                         Tag="AttackTransitionSeconds"
                                                         Style="{StaticResource NumericInput}"
                                                         ToolTip="Допустимый диапазон: 1–30 с."/>
                                                <TextBlock Text="с" Margin="4,3,0,0"
                                                           FontFamily="Consolas" Foreground="#83FFAA"/>
                                                <Button Style="{StaticResource ResetParameterButton}"
                                                        Tag="AttackTransitionSeconds"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider x:Name="AttackTransitionSecondsSlider"
                                                Minimum="1" Maximum="30"
                                                TickFrequency="0.5"
                                                ValueChanged="AnySlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="ПРОВЕРИТЬ АТАКУ"
                                        Height="29"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Right"
                                        Padding="12,2"
                                        Style="{StaticResource ActionButton}"
                                        Click="TestAttackButton_Click"
                                        ToolTip="Немедленно показать переход без ожидания таймера."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="СИСТЕМА" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="#00E667"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ResetParameterButton}"
                                        Tag="SystemBlock"
                                        ToolTip="Сбросить весь системный блок"/>
                            </Grid>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Частота потока"/>
                                    <Button Style="{StaticResource HelpButton}"
                                            ToolTip="Задаёт частоту обновления общего кадра на всех экранах."/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FpsCombo">
                                        <ComboBoxItem Content="24 FPS — кино / рекомендуется" Tag="24"/>
                                        <ComboBoxItem Content="36 FPS — плавно" Tag="36"/>
                                        <ComboBoxItem Content="60 FPS — очень плавно" Tag="60"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Style="{StaticResource ResetParameterButton}" Tag="FramesPerSecond"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="PauseDuringFullscreenAppsCheck"
                                          Content="Пауза в играх"/>
                                <Button Style="{StaticResource HelpButton}" VerticalAlignment="Center"
                                        ToolTip="Полностью приостанавливает поток, пока активно полноэкранное приложение."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows"/>
                                <Button Style="{StaticResource HelpButton}" VerticalAlignment="Center"
                                        ToolTip="Запускает приложение вместе со входом текущего пользователя в Windows."/>
                            </StackPanel>
                            <TextBlock Text="Закрытие этой панели скрывает её. Полный выход — через зелёный значок M в области уведомлений."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#06140C" BorderBrush="#164B2C" BorderThickness="0,1,0,0">
                <Grid Margin="20,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Foreground="#79A888" FontFamily="Consolas"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ComboBox x:Name="PresetCombo" Width="170" Height="30"
                                      Style="{StaticResource FooterPresetCombo}"
                                      IsEnabled="False"
                                      DropDownOpened="PresetCombo_DropDownOpened"
                                      SelectionChanged="PresetCombo_SelectionChanged"
                                      ToolTip="Глобальный профиль всех параметров">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   ToolTip="{Binding Details}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="AddPresetButton"
                                    Content="&#xE710;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource QuickIconButton}"
                                    Width="28" Height="28"
                                    Click="AddPresetButton_Click"
                                    ToolTip="Создать пресет из текущих параметров"/>
                            <Button x:Name="DeletePresetButton"
                                    Content="&#xE738;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource QuickIconButton}"
                                    Width="28" Height="28"
                                    IsEnabled="False"
                                    Click="DeletePresetButton_Click"
                                    ToolTip="Удалить выбранный пресет"/>
                            <Button x:Name="SavePresetButton"
                                    Content="&#xE74E;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource QuickIconButton}"
                                    Width="28" Height="28"
                                    Visibility="Collapsed"
                                    Click="SavePresetButton_Click"
                                    ToolTip="Сохранить изменения в выбранный пресет"/>
                            <Button x:Name="ResetPresetButton"
                                    Content="&#xE777;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource QuickIconButton}"
                                    Width="28" Height="28"
                                    Visibility="Collapsed"
                                    Click="ResetPresetButton_Click"
                                    ToolTip="Вернуть параметры выбранного пресета"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="CancelButton" Content="ОТМЕНИТЬ" Width="130" Height="30"
                                    Margin="0,0,10,0" Visibility="Collapsed"
                                    Style="{StaticResource ActionButton}"
                                    Click="CancelButton_Click"
                                    ToolTip="Вернуть последние применённые параметры"/>
                            <Button x:Name="PauseWallpaperButton" Content="■" Width="44" Height="30"
                                    Margin="0,0,10,0" Padding="0"
                                    FontFamily="Segoe UI Symbol" FontSize="14"
                                    Style="{StaticResource ActionButton}"
                                    Click="PauseWallpaperButton_Click"
                                    ToolTip="Остановить вывод и показать обычные обои Windows"/>
                            <Button x:Name="ApplyButton" Content="СКРЫТЬ" Width="130" Height="30"
                                    Style="{StaticResource ActionButton}"
                                    Click="ApplyButton_Click"
                                    ToolTip="Скрыть консоль; обои продолжат работать в фоне"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
