                                                               FontWeight="Bold" Foreground="#83FFAA"
                                                               VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource HelpButton}"
                                                            ToolTip="Задаёт минимальную глубину прохождения струи по экрану."/>
