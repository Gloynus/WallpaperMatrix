                                    <RowDefinition/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Margin="8,8,8,5" Background="#010503"
                                        BorderBrush="#164B2C" BorderThickness="1"
                                        CornerRadius="4" ClipToBounds="True">
                                    <local:TerminalPreview x:Name="TerminalCodePreview"/>
                                </Border>

                                <Grid Grid.Row="1" Margin="8,4,8,0">
