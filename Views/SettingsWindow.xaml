                                                Margin="10,0,0,0">
                                        <TextBox x:Name="GlyphStretchInput" Tag="GlyphStretch"
                                                 Width="82" Style="{StaticResource NumericInput}"/>
                                        <TextBlock Text="%" Margin="4,3,0,0"
                                                   FontFamily="Consolas" Foreground="#83FFAA"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Margin="10,0,0,0">
                                        <TextBox x:Name="GlyphWeightInput" Tag="GlyphWeight"
                                                 Width="82" Style="{StaticResource NumericInput}"/>
                                        <TextBlock Text="%" Margin="4,3,0,0"
                                                   FontFamily="Consolas" Foreground="#83FFAA"/>
                                    </StackPanel>
                                </Grid>

